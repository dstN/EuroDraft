# EuroDraft — Environment Variables
# Copy this file to .env for local development.
# In production (Netcup + Phusion Passenger), set these under the Node.js
# panel's "Custom environment variables" instead — never commit .env.
# See DEPLOYMENT.md for the full production runbook.

# ── Database (optional) ─────────────────────────────────────────────────
# Backs the /leaderboard feature only — the rest of the app works fine with
# this unset. MySQL/MariaDB via mysql2. See server/db/migrations/ for schema.
DATABASE_URL=mysql://eurodraft:your_password@127.0.0.1:3306/eurodraft

# ── Position enrichment script (scripts/enrich-positions.ts) ────────────
POSITION_SOURCE_BASE_URL=
