# EuroDraft — Environment Variables
# Copy this file to .env for local development.
# In production (Netcup + Phusion Passenger), set these under the Node.js
# panel's "Custom environment variables" instead — never commit .env.
# See DEPLOYMENT.md for the full production runbook.

# ── Database (optional) ─────────────────────────────────────────────────
# Backs the /leaderboard feature and durable share links (/r/<id> surviving
# a restart) -- the rest of the app works fine with this unset. MySQL/
# MariaDB via mysql2. See server/db/migrations/ for schema.
DATABASE_URL=mysql://eurodraft:your_password@127.0.0.1:3306/eurodraft

# ── Contact form email (optional) ───────────────────────────────────────
# Backs the /legal contact form only -- without these, submissions are
# logged to the console instead of sent (local dev), or rejected with a
# clear error pointing at CONTACT_RECIPIENT directly (production -- see
# server/api/contact.post.ts and /api/health's "contactForm" field).
# MAIL_* names are accepted as aliases for the SMTP_* ones below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 'true' forces implicit TLS; otherwise inferred from SMTP_PORT === 465
SMTP_SECURE=
SMTP_FROM="EuroDraft System" <system@example.com>
CONTACT_RECIPIENT=info@example.com

# ── Position enrichment script (scripts/enrich-positions.ts) ────────────
POSITION_SOURCE_BASE_URL=
